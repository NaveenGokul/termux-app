<resources>
    <!-- NGTerminal: used only through ContextThemeWrapper (tab bar, its dialogs); TermuxActivity's theme is unchanged -->
    <style name="Theme.NGTerminal.M3" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ng_primary</item>
        <item name="colorOnPrimary">@color/ng_on_primary</item>
        <item name="colorSecondaryContainer">@color/ng_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ng_on_secondary_container</item>
        <item name="colorSurface">#141218</item>
        <item name="colorOnSurface">@color/ng_on_surface</item>
    </style>
    <!-- NGTerminal: Pixel-style settings (M3 dark, collapsing large title) -->
    <style name="Theme.NGTerminal.Settings" parent="Theme.NGTerminal.M3">
        <item name="android:windowBackground">#141218</item>
        <item name="android:statusBarColor">#141218</item>
        <item name="colorOnSurfaceVariant">@color/ng_on_surface_variant</item>
        <!-- every switch row (stock Termux pages too) gets the M3 MaterialSwitch; wins over PreferenceThemeOverlay (applied with force=false) -->
        <item name="switchPreferenceCompatStyle">@style/NGTerminal.Preference.SwitchPreferenceCompat</item>
    </style>
    <style name="NGTerminal.Preference.SwitchPreferenceCompat" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/ng_preference_switch</item>
    </style>
</resources>
